# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/secure_connect_platform

# JWT Configuration
# Generate a secure 32+ byte key for production or local development (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long_example
JWT_EXPIRES_IN=1h

# Password Hashing
BCRYPT_SALT_ROUNDS=12
